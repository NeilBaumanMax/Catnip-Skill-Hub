# Phase 4 管理员认证。只填写部署环境中的真实值，不得提交到仓库。
CATNIP_ADMIN_EMAIL=
CATNIP_ADMIN_PASSWORD_HASH=
CATNIP_SESSION_SECRET=

# Phase 5 可选：仅用于服务端提高 GitHub API 限额，不得放入客户端或提交真实值。
CATNIP_GITHUB_TOKEN=

# Phase 7 持久化与 S3 兼容对象存储。真实值只放部署秘密环境。
CATNIP_PERSISTENCE_MODE=
DATABASE_URL=
CATNIP_S3_ENDPOINT=
CATNIP_S3_REGION=
CATNIP_S3_BUCKET=
CATNIP_S3_ACCESS_KEY_ID=
CATNIP_S3_SECRET_ACCESS_KEY=
CATNIP_S3_FORCE_PATH_STYLE=

# 本地 Compose 使用；生产环境应由秘密管理器提供。
CATNIP_POSTGRES_PASSWORD=
CATNIP_BIND_ADDRESS=127.0.0.1
CATNIP_BIND_PORT=8080
