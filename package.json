    "deploy:local:bind": "node scripts/set-local-bind-address.mjs",
    "admin:hash-password": "tsx scripts/hash-admin-password.ts",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1097.0",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
