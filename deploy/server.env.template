# Copy this file to a server-only secret file with mode 0600. Never run
# Compose with the placeholder values and never commit the completed file.
CATNIP_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
CATNIP_S3_ACCESS_KEY_ID=REPLACE_WITH_RANDOM_ID
CATNIP_S3_SECRET_ACCESS_KEY=REPLACE_WITH_RANDOM_SECRET
CATNIP_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET

# Keep admin login disabled unless the management paths are isolated from the
# public nginx entry. For Compose env files, escape every literal "$" in the
# generated scrypt hash as "$$" so Compose passes the hash through unchanged.
CATNIP_ADMIN_EMAIL=
CATNIP_ADMIN_PASSWORD_HASH=
CATNIP_GITHUB_TOKEN=

# The host nginx 8080 listener will proxy to this loopback-only port.
CATNIP_BIND_ADDRESS=127.0.0.1
CATNIP_BIND_PORT=18080
